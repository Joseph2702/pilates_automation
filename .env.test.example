# ═══════════════════════════════════════════════════════════════
# .env.test.example - Environment Configuration for Testing
# ═══════════════════════════════════════════════════════════════
#
# Copy this file to .env.test and update with your local values
# This file is used for LOCAL DEVELOPMENT ONLY
#
# For CI/CD (Jenkins), environment variables are set in Jenkinsfile
# 
# ═══════════════════════════════════════════════════════════════

# ─── BASE URLS ───
# The base URL should include the protocol (http:// or https://)
# For local development: http://localhost:8000
# For CI/CD (Jenkins): Set via Jenkinsfile's 'environment' block
BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000/api

# ─── DATABASE CONFIGURATION ───
# Only used if you're connecting to the test database directly
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pilates_test
DB_USER=postgres
DB_PASSWORD=your_db_password

# ─── TEST CREDENTIALS ───
# These accounts must exist in your test database/app
ADMIN_EMAIL=admin@pilates.com
ADMIN_PASSWORD=admin123
CUSTOMER_EMAIL=customer@test.com
CUSTOMER_PASSWORD=password
INSTRUCTOR_EMAIL=jono@femm.com
INSTRUCTOR_PASSWORD=password

# ─── TIMEOUTS (milliseconds) ───
TIMEOUT=30000
NAVIGATION_TIMEOUT=30000

# ─── ENVIRONMENT ───
ENV=test
DEBUG=false

# ═══════════════════════════════════════════════════════════════
# IMPORTANT NOTES FOR CI/CD (JENKINS):
# ═══════════════════════════════════════════════════════════════
#
# In Jenkinsfile, these variables are set in the 'environment' block:
#
#   environment {
#       BASE_URL            = "${params.BASE_URL}"
#       API_BASE_URL        = "${params.BASE_URL}/api"
#       ADMIN_EMAIL         = 'admin@pilates.com'
#       ADMIN_PASSWORD      = 'admin123'
#       CUSTOMER_EMAIL      = 'customer@test.com'
#       CUSTOMER_PASSWORD   = 'password'
#       INSTRUCTOR_EMAIL    = 'jono@femm.com'
#       INSTRUCTOR_PASSWORD = 'password'
#   }
#
# These override any .env.test file that might exist.
# Ensure the BASE_URL parameter is set correctly when running builds.
#
# ═══════════════════════════════════════════════════════════════
