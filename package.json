{
  "name": "pilates-automation",
  "version": "1.0.0",
  "description": "Automation testing for Pilates Management System",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:e2e": "playwright test tests/e2e",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",

    "test:api:smoke": "npx playwright test --project=api-smoke",
    "test:api:regression": "npx playwright test --project=api-regression",
    "test:ui:smoke": "npx playwright test --project=ui-smoke",
    "test:ui:regression": "npx playwright test --project=ui-regression",
    "test:smoke": "npx playwright test --project=api-smoke --project=ui-smoke",
    "test:all": "npx playwright test",

    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "setup": "node --loader ts-node/esm scripts/setup.ts",
    "seed": "node --loader ts-node/esm scripts/seed-data.ts",
    "cleanup": "node --loader ts-node/esm scripts/cleanup.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.1",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "allure-playwright": "^3.0.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.3.1"
  }
}